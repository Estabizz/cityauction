# Hostinger MySQL connection string. Never commit real credentials.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
# Random string, 32+ characters, used to sign sessions and hash OTPs.
AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="https://cityauction.in"

# Phone.Email is the default email verification widget (public client ID).
NEXT_PUBLIC_EMAIL_OTP_PROVIDER="phone-email"
NEXT_PUBLIC_PHONE_EMAIL_CLIENT_ID="11716953482701480507"

# Optional SMTP fallback: set NEXT_PUBLIC_EMAIL_OTP_PROVIDER="smtp" to use it.
# The default Phone.Email flow does not need SMTP credentials.
# There is no per-OTP application charge. Your email provider's quotas apply.
SMTP_HOST=""
# Optional: 465 (TLS, default) or 587 (required STARTTLS).
SMTP_PORT=""
SMTP_USER=""
# A mailbox/app password, stored only in the hosting environment.
SMTP_PASSWORD=""
# The sender email your mailbox/provider authorizes (e.g. a company address).
MAIL_FROM=""
